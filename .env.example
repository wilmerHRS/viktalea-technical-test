# Copia este archivo a .env. Se valida al arrancar (src/config/env.ts):
# si alguna variable es inválida, la app no inicia y muestra cuál falla.

# development | production | test   (por defecto: development)
NODE_ENV=development

# Entero entre 1 y 65535   (por defecto: 3000)
PORT=3000

# "*" o lista separada por comas: https://app.com,http://localhost:5173   (por defecto: *)
CORS_ORIGIN=*

# --- PostgreSQL: deben coincidir con docker-compose.yml ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=cashin
DB_PASSWORD=cashin_local
# Base de la app. Los tests usan "cashin_test" (ver .env.test)
DB_NAME=cashin

WEBHOOK_SECRET=local_webhook_secret_change_me
PROVIDER_TIMEOUT_MS=5000
RECONCILE_INTERVAL_MS=30000
RECONCILE_AFTER_MS=30000
RECONCILE_LEASE_MS=60000
LOG_LEVEL=info
